# ---------------------------------------------------------------------------
# Miqaat Core Identity Authorization Service - environment template
# This service NEVER stores passwords or password hashes.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
# Proxy trust for deriving the client IP, which session binding compares against.
#   false            direct exposure (local dev)
#   <n>              trusted proxy hops in front of this service (Render / ALB / nginx: 1)
#   <cidr>[,<cidr>]  trust exactly these proxy addresses
# "true" is refused: it trusts a client-supplied X-Forwarded-For, which would defeat IP binding.
TRUST_PROXY=false
SWAGGER_ENABLED=true

# --- Authorization DB: the EXISTING admin database (PostgreSQL) -------------
# ALL REQUIRED, NO DEFAULTS. Use the exact existing host, port, database, schema and credentials.
# Existing users, tenants, roles, user_roles, role_permissions, modules, permission_actions and module_actions
# are READ from AUTHZ_DB_SCHEMA; the service refuses to start if the schema or any mapped table/column is missing.
# Docker never creates a database, schema or table. In Docker, "localhost" is the container itself.
AUTHZ_DB_HOST=
AUTHZ_DB_PORT=
AUTHZ_DB_NAME=admin_db
AUTHZ_DB_SCHEMA=public
AUTHZ_DB_USER=
AUTHZ_DB_PASSWORD=
AUTHZ_DB_SSL=false
# admin_db is managed by the Admin service. Keep false: migrations, seed/onboarding scripts and the
# e2e tests (which reset tables) then refuse to run, so nothing is created, altered or deleted there.
AUTHZ_DB_MIGRATIONS_ENABLED=false

# --- Redis (effective-permission cache) ------------------------------------
# An existing Redis; no Redis container is started by docker-compose.
REDIS_URL=redis://localhost:6392/0
EFFECTIVE_PERMISSION_CACHE_TTL_SECONDS=60

# Allow http://localhost origins/callbacks (never true in UAT/PROD)
ALLOW_INSECURE_LOCALHOST_URIS=true

# Write ALLOW decisions to the audit table (denials are always written)
AUDIT_ALLOW_DECISIONS=false
# admin_db has no authorization_audit_logs table: keep false, audit events go to the structured log.
AUDIT_DB_ENABLED=false

# --- Bearer token authentication (RS256 JWTs verified via JWKS; no API keys) ---
# Admin user access tokens are issued by Identity Federation and verified with its JWKS.
IDENTITY_ISSUER=http://localhost:3001
IDENTITY_JWKS_URI=http://localhost:3001/.well-known/jwks.json
AUTHZ_AUDIENCE=miqaat-core-authorization
# Administrator rights come from Core RBAC (roles x scopes) for the token's active scope
DEFAULT_TENANT_NAME=Miqaat
CORE_PORTAL_APPLICATION_CODE=core-portal
SERVICE_TOKEN_MAX_LIFETIME_SECONDS=300
ACCESS_TOKEN_MAX_LIFETIME_SECONDS=900
JWT_CLOCK_TOLERANCE_SECONDS=5

# --- Authorization's OWN signing key (separate from Identity's keys) --------
# Signs authorization tokens (typ authz+jwt); public key at http://localhost:3002/.well-known/jwks.json
AUTHZ_ISSUER=http://localhost:3002
AUTHORIZATION_TOKEN_TTL_SECONDS=300
# Development: generated on first start into this git-ignored file.
AUTHZ_SIGNING_KEY_FILE=.keys/authorization-signing.pem
# Production: required, PKCS#8 PEM injected from a secret store (e.g. SSM Parameter Store, Standard tier, SecureString).
# AUTHZ_SIGNING_PRIVATE_KEY=
