{
  "name": "miqaat-core-identity-authorization-service",
  "version": "1.0.0",
  "description": "Miqaat Core Identity Authorization Service - dynamic BU/utility/application/module/role/permission model and client registry",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node node_modules/@nestjs/cli/bin/nest.js build && node node_modules/tsc-alias/dist/bin/index.js -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node node_modules/@nestjs/cli/bin/nest.js start --watch",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "migration:run": "node -r ts-node/register/transpile-only -r tsconfig-paths/register node_modules/typeorm/cli.js migration:run -d src/core/database/data-source.ts",
    "migration:revert": "node -r ts-node/register/transpile-only -r tsconfig-paths/register node_modules/typeorm/cli.js migration:revert -d src/core/database/data-source.ts",
    "migration:run:prod": "node node_modules/typeorm/cli.js migration:run -d dist/core/database/data-source.js",
    "seed": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/seed-catalog.ts",
    "seed:access": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/seed-user-access.ts",
    "openapi:export": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/export-openapi.ts",
    "test": "node node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-e2e.json --runInBand --forceExit",
    "test:all": "npm run test && npm run test:e2e",
    "infra:up": "docker compose -f docker/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml --env-file .env down",
    "docker:build": "docker build -f docker/Dockerfile -t miqaat-core-identity-authorization-service:local .",
    "principal:register": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/register-service-principal.ts",
    "client": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/manage-client.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "^5.12.4",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@config$": "<rootDir>/src/config",
      "^@config/(.*)$": "<rootDir>/src/config/$1",
      "^@common$": "<rootDir>/src/common",
      "^@common/(.*)$": "<rootDir>/src/common/$1",
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^@modules/(.*)$": "<rootDir>/src/modules/$1",
      "^@shared$": "<rootDir>/src/shared",
      "^@shared/(.*)$": "<rootDir>/src/shared/$1"
    }
  }
}
